{
  "name": "budget-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "package": "electron-builder -c.extraMetadata.main=electron.cjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "chart.js": "^4.4.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.budget-tracker.app",
    "productName": "Budget Tracker",
    "publish": "never",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.js"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "icon/icon.png"
    },
    "mac": {
      "icon": "icon/icon.png"
    }
  }
}
